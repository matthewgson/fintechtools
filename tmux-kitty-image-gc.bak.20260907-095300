#!/usr/bin/env bash
# Tear down the Kitty-protocol images bookokrat leaves behind.
#
# Why this is needed
# ------------------
# Under Ghostty, bookokrat draws a PDF page as a CLASSIC Kitty placement — an
# image positioned from #{pane_top}/#{pane_left} and handed to Ghostty through
# the \ePtmux; passthrough. tmux holds no cell in its grid that stands for that
# image, so nothing tmux does can remove it: switch windows and tmux repaints
# the text while the page stays painted over whatever you switched to, and quit
# the reader and the page simply stays (bookokrat#179).
#
# bookokrat cannot clean up after itself either: it handles no focus events,
# and the pane option it sets is `allow-passthrough on`, not `all`, so tmux
# drops any graphics escape a hidden pane emits. The teardown has to come from
# outside tmux. That is this script.
#
# Do NOT "fix" this by forcing bookokrat's Unicode-placeholder anchor path on
# (the ~/.local/bin/override wrapper that used to live here did exactly that).
# The anchor path draws the page as a placement RELATIVE to a 1x1 tmux-owned
# cell, using the Kitty keys P= and Q=. Ghostty 1.3.1 does not implement
# relative placements: it drops P/Q and places the image at wherever the
# terminal cursor happens to be — measured, that is the middle of yazi's pane,
# so the page lands on top of the file list while the reader's own pane stays
# empty. Verified by screenshot, 2026-09-04.
#
# What this does
# --------------
# 1. Writes Kitty delete escapes straight to each client's tty — the pty whose
#    far end is Ghostty. Going direct is the whole point: it sidesteps tmux's
#    pane-visibility rules, which is why the same escape sent through the pane
#    would be swallowed.
#
#    The deletes are TARGETED, not `d=A`. A screen-wide wipe would also blank
#    yazi's own preview, and yazi does not redraw on demand, so the preview
#    column would just go blank and stay blank.
#      d=Z,z=-1 deletes every placement at z-index -1. bookokrat draws its page
#               there; yazi's preview sits at the default z=0 and survives.
#               Keyed on z rather than image id so it keeps working if a future
#               bookokrat numbers its pages differently.
#      d=I,i=1  frees the page image itself, which bookokrat always sends as
#               image id 1.
#    q=2 on both: without it Ghostty replies "OK" and the reply is delivered to
#    the pane's foreground process as keystrokes (observed: a stray `rma`
#    typed into the shell).
#
# 2. Sends C-l to every reader pane that is on screen NOW. Upstream binds that
#    to force_redraw = delete_all_images() + re_enqueue_pdf_images() + clear,
#    so a reader you just switched BACK to repaints itself. Costs a brief blank
#    (~100-300ms per the render log) on return; that is the price of the page
#    not smearing over every other window.
#
#    That figure is the LOCAL one. Driving the CIRCE container over SSH, the
#    same repaint costs the remote page floor instead — ~1-1.5s, measured, with
#    no knob to turn: MuPDF renders on the compute node and the image crosses
#    the link as chunked kitty-graphics data. Identical mechanism, visibly
#    slower, and not a fault to go looking for.
#
# Wired up in ~/.config/tmux/tmux.conf (session-window-changed,
# client-session-changed) and by bookokrat-split when the reader exits. One copy
# of this file serves both machines: the Mac's ~/.config/tmux/tmux.conf, and the
# container's, which 05_Container/sync_configs.sh rsyncs from
# configs/tmux/tmux.conf alongside this script.
#
# Usage: tmux-kitty-image-gc [--exiting]
#   --exiting  called from inside a reader pane whose bookokrat has just quit;
#              that pane is skipped when handing out repaints.
set -euo pipefail

# Resolve tmux by absolute path first. This script's main caller is a tmux
# HOOK, and `run-shell` hands the command the tmux server's own environment —
# whatever PATH the server happened to inherit whenever it started, which on a
# Mac need not contain /opt/homebrew/bin. A bare `tmux` that fails to resolve
# would make this exit 0 and do nothing, silently, forever.
#
# The list covers both machines this script runs on. /opt/homebrew is the Mac;
# /usr/local/bin is where the CIRCE container's tmux lives, because it is built
# from source there (Dockerfile stage 8g — Ubuntu 24.04 pins tmux 3.4, which
# predates the CSI-u extended keys ghostty sends). /usr/bin is a last resort for
# a plain distro package. First hit wins, so the more specific paths lead.
for _t in /opt/homebrew/bin/tmux /usr/local/bin/tmux /usr/bin/tmux; do
    [[ -x "$_t" ]] && { tmux() { command "$_t" "$@"; }; break; }
done
command -v tmux >/dev/null 2>&1 || exit 0

exiting=0
[[ "${1:-}" == --exiting ]] && exiting=1

# One sweep of every pane on the SERVER, and every field is a tmux-generated
# token, so nothing here can be broken by a filename with a space in it.
#
# `-a`, not `-s`: run-shell inside a hook has no explicit target, so a
# session-scoped listing is at the mercy of whichever session tmux decides is
# "current" at that moment. On a server with one session that is always the
# right one, which is exactly why this passed testing and still left the page
# on screen in a real 15-session setup. The image is painted on a physical
# terminal, not in a session, so the search has to be server-wide too.
#
# A pane counts as a reader if EITHER
#   @bkfile is set — the tag bookokrat-split puts on panes it creates. Needed
#     because those panes run `settle; reader; cleanup`, so zsh cannot exec the
#     reader and tmux reports the pane's command as `zsh` the whole time.
#   its command is literally bookokrat — a reader started by hand at a shell
#     prompt, which carries no tag. Without this arm, `bookokrat file.pdf`
#     typed into a window was never cleaned up after at all.
readers=""       # pane ids of readers on an attached session
visible=""       # ...of those, the ones on screen right now
while read -r id tagged win_active attached cmd; do
    if [[ "$tagged" != 1 && "$cmd" != bookokrat ]]; then continue; fi
    (( attached > 0 )) || continue      # nobody is looking at it; nothing painted
    readers="$readers $id"
    if (( win_active )); then visible="$visible $id"; fi
done < <(tmux list-panes -a \
             -F '#{pane_id} #{?@bkfile,1,0} #{window_active} #{session_attached} #{pane_current_command}' \
             2>/dev/null || true)

# Stay out of the way unless a reader is actually involved: the deletes are
# screen-wide within their z-index, and an unrelated image could sit there.
[[ -n "$readers" ]] || exit 0

# Every attached client, not just one: the same session can be on two screens,
# and a reader in one session paints the same physical terminal as any other.
while read -r tty; do
    [[ -n "$tty" && -w "$tty" ]] || continue
    printf '\033_Ga=d,d=Z,z=-1,q=2\033\\\033_Ga=d,d=I,i=1,q=2\033\\' > "$tty"
done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null || true)

# Repaint whichever readers are on screen now — nothing to do if we just left
# one. Only --exiting skips the calling pane: a hook fires with TMUX_PANE set
# to the pane you just switched TO, which is very often the reader that needs
# the repaint, so skipping it unconditionally would defeat the whole thing.
for id in $visible; do
    if (( exiting )) && [[ "$id" == "${TMUX_PANE:-}" ]]; then continue; fi
    tmux send-keys -t "$id" C-l 2>/dev/null || true
done

# Explicitly 0. tmux shows a run-shell that returns non-zero as an error on the
# status line of the window you just switched to, so a loop that simply found
# nothing to do must not be the last thing to set the exit status.
exit 0
